Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# Never expose application code, credentials, logs or dependency files.
RewriteRule ^(?:app|bootstrap|config|database|lang|resources|routes|storage|vendor)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|.*\.(?:sql|sqlite|log))$ - [F,L,NC]

# htdocs is fixed on this host. Only public/ is the application web root.
RewriteRule ^public(?:/|$) - [L]
RewriteRule ^(.*)$ public/$1 [L]
